{% endif %}

namespace {{ machine.name }}_sml {
struct Runtime;
}

/// {{ machine.displayName }}{{ " (protocol state machine)" if machine.protocol }}, run by Boost.SML.
///
/// Events are processed one at a time, each to completion; events sent while one is processed are queued.
/// Call startMachine() once, then send events.
class {{ machine.name }} : public {{ machine.name }}Events {
public:
    /// What the machine tells whoever runs it.
    class Listener {
    public:
        virtual ~Listener() = default;
        /// Every top-level region reached a final state.
        virtual void onFinished() {}
{% if exitPoints %}
        /// The machine left through one of its exit points.
        virtual void onExitPoint({{ machine.name }}ExitPoint point) { (void)point; }
{% endif %}
        /// Tracing, e.g. to a log for FSM Editor's Trace Player: called for each event processed ("event"), state
        /// entered ("enter") or left ("exit"), and transition taken ("transition": each segment of a compound
        /// transition, so the branches taken at choices and junctions too). `machine` is the machine's name, followed
        /// for a submachine by the submachine states leading to it ("{{ machine.name }}.State"); `id` is the xmi:id of
        /// the state or transition (the name of an event), and `name` its name.
        virtual void onTrace(const char* machine, const char* kind, const char* id, const char* name) {
            (void)machine;
            (void)kind;
            (void)id;
            (void)name;
        }
    };

{% if features.anyTimers %}
    /// `timers` runs the timers of its time events{{ " and of its submachines'" if features.submachineTimers }}.
    {{ machine.name }}({{ machine.name }}Actions& actions, FsmTimers& timers);
{% else %}
    explicit {{ machine.name }}({{ machine.name }}Actions& actions);
{% endif %}
    ~{{ machine.name }}() override;
    {{ machine.name }}(const {{ machine.name }}&) = delete;
    {{ machine.name }}& operator=(const {{ machine.name }}&) = delete;

    /// Tells `listener` (or nobody, with nullptr) when the machine finishes{{ " or leaves through an exit point" if exitPoints }}.
    void setListener(Listener* listener);
    /// Enters the machine through its initial pseudostates.
    void startMachine();
{% if entryPoints %}
    /// Enters the machine through one of its entry points.
    void startMachineAt({{ machine.name }}EntryPoint point);
{% endif %}
    /// Re-enters the states that were active when the machine was last stopped.
    void resumeMachine();
    /// Leaves every active state, running their exit behaviors.
    void stopMachine();

{% for e in events %}
    void {{ e.name | id }}() override;
{% endfor %}
{% if features.activities %}
    void activityDone({{ machine.name }}Activity activity) override;
{% endif %}

    bool isIn({{ machine.name }}State state) const;
    std::vector<{{ machine.name }}State> activeStates() const;
    /// Every top-level region reached a final state.
    bool isFinished() const;
    /// A terminate pseudostate was reached.
    bool isTerminated() const;

    /// For a parent machine running this one as a submachine: processes `event` now, and tells whether it was used.
    bool offer({{ machine.name }}Event event);

private:
    std::unique_ptr<{{ machine.name }}_sml::Runtime> runtime_;
};
{% endfilter %}

{# ================================================================ Order.cpp #}
{% filter file(machine.name ~ ".cpp") %}
{{ generated() }}
//
// {{ machine.displayName }} as Boost.SML transition tables: one per composite state, and Machine for the machine.
// Boost.SML runs the tables (event dispatch, priority of substates, exits and entries); the runtime around them,
// Context and Runtime, adds what UML needs and Boost.SML lacks:
// - Run to completion: events, completion events and timers are queued and processed one at a time. Completion
//   events go first, and deferred events are dispatched again after the next state change.
// - Transitions out of a composite state's inside: the substate takes the event and posts a continuation, an
//   internal event the table of the composite state takes right away (next()).
// - Transitions into a composite state's inside (nested targets, entry points, forks, history): each region
//   starts in an initial pseudostate whose anonymous transitions follow the route set by the transition (route()).
#include "{{ machine.name }}.h"
{% for sub in submachines %}
#include "{{ sub.name }}.h"
{% endfor %}

#include <boost/sml.hpp>

#include <array>
{% if features.timers %}
#include <chrono>
#include <cstdint>
{% endif %}
{% if features.submachines %}
#include <cstring>
{% endif %}
#include <deque>
#include <initializer_list>
{% if features.timers %}
#include <memory>
{% endif %}
#include <optional>
{% if features.choices %}
#include <stdexcept>
{% endif %}
{% if features.choices or features.submachines %}
#include <string>
{% endif %}
#include <vector>

namespace {{ machine.name }}_sml {

namespace sml = boost::sml;

{# ---------------------------------------------------------------- the constants and events #}
inline constexpr int STATE_COUNT = {{ states | length }};
inline constexpr int REGION_COUNT = {{ regions | length }};
inline constexpr int EVENT_COUNT = {{ events | length }};
inline constexpr int TIMER_COUNT = {{ timers | length }};
/// Region containing each state.
inline constexpr std::array<int, STATE_COUNT> REGION_OF = { {{- states | map(attribute="regionIndex") | join(", ") -}} };
/// State owning each region (-1 for the top-level ones).
inline constexpr std::array<int, REGION_COUNT> OWNER_OF = { {{- regions | map(attribute="ownerIndex") | join(", ") -}} };
inline constexpr std::array<bool, STATE_COUNT> IS_FINAL = { {{- states | map(attribute="isFinal") | map("lower") | join(", ") -}} };
/// When each state completes: 0 when entered, 1 when its do activities end, 2 when its regions are final, 3 when its
/// submachine finishes, 4 never (final states).
inline constexpr std::array<int, STATE_COUNT> COMPLETES = { {%- for s in states %}{{ ", " if not loop.first }}{{ options.completes[s.completes] }}{% endfor -%} };
inline constexpr std::array<int, STATE_COUNT> ACTIVITY_COUNT = { {%- for s in states %}{{ ", " if not loop.first }}{{ s.activities | length }}{% endfor -%} };
/// Table event of each state's completion (-1: no transition waits for it).
inline constexpr std::array<int, STATE_COUNT> COMPLETION_EVENT = { {%- for e in tables.completionEvents %}{{ ", " if not loop.first }}{{ e.index if e else -1 }}{% endfor -%} };
inline constexpr std::array<const char*, STATE_COUNT> STATE_NAMES = { {{- states | map(attribute="name") | map("quote") | join(", ") -}} };
/// xmi:id of each state, and the name of each signal (events, then timers), for tracing.
inline constexpr std::array<const char*, STATE_COUNT> STATE_IDS = { {{- states | map(attribute="id") | map("quote") | join(", ") -}} };
inline constexpr std::array<const char*, {{ signals | length }}> SIGNAL_NAMES = { {{- signals | map(attribute="name") | map("quote") | join(", ") -}} };
inline constexpr int START = {{ (tables.events | selectattr("kind", "eq", "start") | first).index }};
inline constexpr int STOP = {{ (tables.events | selectattr("kind", "eq", "stop") | first).index }};
/// Region entry routes: 0 by default, 1 deep resume (resumeMachine(), deep history); the others are in the tables.
inline constexpr int DEEP = 1;
inline constexpr int NONE = 0;
inline constexpr int DEFERRED = 1;
inline constexpr int FIRED = 2;

/// The machine's events.
namespace events {
{% for e in events %}
struct {{ e.name | id }} {};
{% endfor %}
}  // namespace events

/// Events of the tables themselves: start and stop, timers, completion events, continuations, submachine exit points.
namespace internal {
{% for e in tables.events %}
struct {{ e.name | id }} {};
{% endfor %}
}  // namespace internal

/// States: simple and final states are tags, composite states are the structs of their tables (below).
namespace states {
{% for s in states if not s.regions %}
struct {{ s.name | id }};
{% endfor %}
}  // namespace states

/// Pseudostates of the tables: where regions start, choices, and where a table waits to be left.
namespace pseudo {
{% for t in tables.list %}
{% for p in t.pseudostates %}
struct {{ p.name | id }};
{% endfor %}
{% endfor %}
}  // namespace pseudo

/// Thrown by a terminate pseudostate, to stop at once.
struct Terminated {};

{# ---------------------------------------------------------------- Context
   A submachine state's submachine also gets the timers when it has time events. #}
/// What the guards and actions of the tables use: the actions, and the bookkeeping of the run-time configuration.
struct Context {
    {{ "explicit " if not features.anyTimers }}Context({{ machine.name }}Actions& actions{{ ", FsmTimers& timers" if features.anyTimers }})
        : actions(actions)
        {%- if features.timers %},
          fsmTimers(timers)
        {%- endif %}
        {%- for s in states if s.submachine %},
          sub_{{ s.name }}(actions.submachine{{ s.name | pascal }}(){% for sub in submachines if sub.href == s.submachine.href and sub.timers %}, timers{% endfor %}),
          listener_{{ s.name }}(*this)
        {%- endfor %} {
        active.fill(-1);
        history.fill(-1);
{% for s in states if s.submachine %}
        sub_{{ s.name }}.setListener(&listener_{{ s.name }});
{% endfor %}
    }
    Context(const Context&) = delete;
    Context& operator=(const Context&) = delete;
    virtual ~Context() {
{% if features.timers %}
        for (int t = 0; t < TIMER_COUNT; ++t) cancelTimer(t);
{% endif %}
{% for s in states if s.submachine %}
        sub_{{ s.name }}.setListener(nullptr);
{% endfor %}
    }

    /// Processes the queued events, unless they are being processed.
    virtual void run() = 0;

    {{ machine.name }}Actions& actions;
{% if features.timers %}
    FsmTimers& fsmTimers;
{% endif %}
    {{ machine.name }}::Listener* listener = nullptr;
    /// Active state of each region (-1: none), last active state (-1: none or final), entry route and its history (0 none, 1 shallow, 2 deep).
    std::array<int, REGION_COUNT> active{};
    std::array<int, REGION_COUNT> history{};
    std::array<int, REGION_COUNT> mode{};
    std::array<int, REGION_COUNT> hist{};
    std::array<bool, STATE_COUNT> completed{};
    /// Do activities still running in each state.
    std::array<int, STATE_COUNT> pending{};
{% if features.submachines %}
    /// How each submachine state starts its submachine: 0 by default, 1 resumed, 2 + n at its entry point n.
    std::array<int, STATE_COUNT> submode{};
{% endif %}
    /// Events (signals) to process, deferred ones, completion events and exit points to process first, and the
    /// continuations of the transition being fired, processed before anything else.
    std::deque<int> queue;
    std::vector<int> deferred;
    std::deque<int> work;
    std::deque<int> continuations;
{% if features.postconditions %}
    std::vector<int> postconditions;
{% endif %}
{% if features.preconditions %}
    const char* preconditionFailed = nullptr;
{% endif %}
{% if exitPoints %}
    int exitPoint = -1;
{% endif %}
    bool finished = false;
    bool terminated = false;
{% if features.deferral %}
    bool fired = false;
    bool deferredNow = false;
{% endif %}
{# The listener a parent gives each submachine: what it reports becomes this machine's events. #}
{% for sub in submachines %}
{% for st in sub.states %}

    /// Hands what the submachine of {{ st.name }} reports to this machine.
    struct {{ st.name }}Listener final : {{ sub.name }}::Listener {
        explicit {{ st.name }}Listener(Context& c) : c(c) {}
        void onFinished() override {
            if (c.isActive({{ st.index }})) c.completion({{ st.index }});
            c.run();
        }
{% if sub.exitPoints %}
        void onExitPoint({{ sub.name }}ExitPoint point) override {
            (void)point;
{% for e in tables.events if e.kind == "exitPoint" and e.ref.index == st.index %}
            if (point == {{ sub.name }}ExitPoint::{{ e.point | id }}) c.work.push_back({{ e.index }});
{% endfor %}
            c.run();
        }
{% endif %}
        void onTrace(const char* machine, const char* kind, const char* id, const char* name) override {
            if (!c.listener) return;
            const char* rest = std::strchr(machine, '.');
            const std::string path = std::string("{{ machine.name }}.{{ st.name }}") + (rest ? rest : "");
            c.listener->onTrace(path.c_str(), kind, id, name);
        }
        Context& c;
    };
    {{ sub.name }} sub_{{ st.name }};
    {{ st.name }}Listener listener_{{ st.name }};
{% endfor %}
{% endfor %}

    bool isActive(int s) const { return s >= 0 && active[REGION_OF[s]] == s; }

    void trace(const char* kind, const char* id, const char* name) {
        if (listener) listener->onTrace({{ machine.name | quote }}, kind, id, name);
    }

    void enter(int s) {
        active[REGION_OF[s]] = s;
        completed[s] = false;
        trace("enter", STATE_IDS[s], STATE_NAMES[s]);
        if (COMPLETES[s] == 1) pending[s] = ACTIVITY_COUNT[s];
    }

    void entered(int s) {
        if (IS_FINAL[s]) finalReached(REGION_OF[s]);
        else if (COMPLETES[s] == 0) completion(s);
    }

    void exited(int s) {
        const int r = REGION_OF[s];
        active[r] = -1;
        history[r] = IS_FINAL[s] ? -1 : s;
        completed[s] = false;
        trace("exit", STATE_IDS[s], STATE_NAMES[s]);
    }

    void finalReached(int region) {
        const int owner = OWNER_OF[region];
        for (int r = 0; r < REGION_COUNT; ++r) {
            if (OWNER_OF[r] == owner && (active[r] < 0 || !IS_FINAL[active[r]])) return;
        }
        if (owner >= 0) {
            completion(owner);
        } else {
            finished = true;
            if (listener) listener->onFinished();
        }
    }

    void completion(int s) {
        completed[s] = true;
        if (COMPLETION_EVENT[s] >= 0) work.push_back(COMPLETION_EVENT[s]);
    }

    bool allCompleted(std::initializer_list<int> states) const {
        for (int s : states) {
            if (!isActive(s) || !completed[s]) return false;
        }
        return true;
    }

    /// Continues the transition being fired in the table of the state it leaves next.
    void next(int event) { continuations.push_back(event); }

    void route(int region, int to, int h) {
        mode[region] = to;
        hist[region] = h;
    }

    void entering(int region) { route(region, 0, 0); }

    bool routed(int region, int to) const { return mode[region] == to && (hist[region] == 0 || history[region] < 0); }

    bool restores(int region, int to, int s) const { return mode[region] == to && hist[region] != 0 && history[region] == s; }

    bool defaults(int region) const { return mode[region] == 0 || (mode[region] == DEEP && history[region] < 0); }

    /// Region `region` restores its last active state `s`; a deep history goes on with the regions of `s`.
    void restore(int region, int s) {
        const bool deep = hist[region] == 2;
        entering(region);
        for (int r = 0; r < REGION_COUNT; ++r) {
            if (deep && OWNER_OF[r] == s) route(r, DEEP, 2);
        }
{% if features.submachines %}
        submode[s] = deep ? 1 : 0;
{% endif %}
    }
{% if features.submachines %}

    void startAt(int s, int point) { submode[s] = 2 + point; }

    void startSubmachine(int s) {
        const int how = submode[s];
        submode[s] = 0;
        switch (s) {
{% for s in states if s.submachine %}
        case {{ s.index }}:
{# Starting the submachine of a submachine state: by default, resumed, or at an entry point. #}
{% for sub in submachines if sub.href == s.submachine.href %}
{% if sub.entryPoints %}
            if (how >= 2) sub_{{ s.name }}.startMachineAt(static_cast<{{ sub.name }}EntryPoint>(how - 2));
            else if (how == 1) sub_{{ s.name }}.resumeMachine();
            else sub_{{ s.name }}.startMachine();
{% else %}
            if (how == 1) sub_{{ s.name }}.resumeMachine();
            else sub_{{ s.name }}.startMachine();
{% endif %}
{% endfor %}
            break;
{% endfor %}
        default:
            (void)how;
            break;
        }
    }
{% endif %}
{% if features.deferral %}

    void defer() { deferredNow = true; }
{% endif %}
{% if features.preconditions %}

    bool pre(bool holds, const char* label) {
        if (!holds && !preconditionFailed) preconditionFailed = label;
        return holds;
    }
{% endif %}
{% if features.postconditions %}

    void postcondition(int index) { postconditions.push_back(index); }
{% endif %}

    void checkPostconditions() {
{% if features.postconditions %}
        Context& c = *this;
        for (int index : postconditions) {
            switch (index) {
{% for p in tables.postconditions %}
            case {{ p.index }}:
                if (!({{ p.condition | guard }})) c.actions.onConstraintViolation({{ machine.name }}Constraint::postcondition, {{ p.element | quote }});
                break;
{% endfor %}
            default:
                break;
            }
        }
        postconditions.clear();
{% endif %}
    }

    void checkInvariants() {
{% if invariants %}
        Context& c = *this;
{% for s in invariants %}
        if (isActive({{ s.index }}) && !({{ s.invariant | guard }})) c.actions.onConstraintViolation({{ machine.name }}Constraint::invariant, {{ s.name | quote }});
{% endfor %}
{% endif %}
    }
{% if exitPoints %}

    /// Leaves through exit point `point`: the other top-level regions are left too, then the listener is told.
    void exitMachine({{ machine.name }}ExitPoint point) {
        exitPoint = static_cast<int>(point);
        next(STOP);
    }
{% endif %}
{% if features.terminate %}

    [[noreturn]] void terminate() {
        terminated = true;
{% if features.timers %}
        for (int t = 0; t < TIMER_COUNT; ++t) cancelTimer(t);
{% endif %}
        queue.clear();
        work.clear();
        continuations.clear();
        actions.onTerminate();
        throw Terminated{};
    }
{% endif %}
{% if features.choices %}

    [[noreturn]] void noBranch(const char* choice) {
        throw std::logic_error(std::string("{{ machine.name }}: no branch of the ") + choice + " can be taken.");
    }
{% endif %}
{% if features.timers %}

    std::array<FsmTimers::Id, TIMER_COUNT> timerIds{};
    std::array<bool, TIMER_COUNT> armed{};
    std::array<unsigned, TIMER_COUNT> generation{};
    /// Expires with the machine, so that a timer firing late does nothing.
    std::shared_ptr<int> alive = std::make_shared<int>(0);

    void startTimer(int t, double ms) {
        cancelTimer(t);
        const unsigned gen = ++generation[t];
        armed[t] = true;
        const std::weak_ptr<int> token = alive;
        const auto delay = std::chrono::ceil<std::chrono::milliseconds>(std::chrono::duration<double, std::milli>(ms));
        timerIds[t] = fsmTimers.startTimer(delay, [this, t, gen, token] {
            if (token.expired() || !armed[t] || generation[t] != gen) return;
            armed[t] = false;
            queue.push_back(EVENT_COUNT + t);
            run();
        });
    }

    void cancelTimer(int t) {
        if (!armed[t]) return;
        armed[t] = false;
        fsmTimers.cancelTimer(timerIds[t]);
    }
{% endif %}
};
