---
# C++17 with Boost.SML (https://github.com/boost-ext/sml). For a machine named Order it writes:
#   OrderEvents.h    what the machine reacts to: the OrderEvents interface, one method per event
#   OrderActions.h   what the machine needs: the OrderActions interface to implement (behaviors,
#                    conditions, do activities)
#   FsmTimers.h      the timers of time events (after(...)), shared by every machine: implement
#                    FsmTimers once and pass it to the machines that have time events
#   Order.h          the Order class, which implements OrderEvents
#   Order.cpp        its implementation: the Boost.SML transition tables and their runtime.
#                    Only this file includes <boost/sml.hpp>.
# Implement OrderActions in your own class, in a file of your own.
#
# Boost.SML has no transitions across composite states, entry or exit points, forks, joins,
# history that behaves like UML's, or local transitions: the generated code works around them
# and the generator prints a warning for each. What it cannot express is an error, and nothing
# is generated.
#
# The template has three parts: the pieces of C++ (macros), the checks (warnings and errors),
# then the files.
lang: cpp
guard:
  prefix: "c.actions."
options:
  # Methods of the generated class and of the actions interface, which events and behaviors cannot be named after.
  classMethods: [startMachine, startMachineAt, resumeMachine, stopMachine, setListener, activityDone, isIn, activeStates, isFinished, isTerminated, offer]
  actionsMethods: [onConstraintViolation, onTerminate]
  # Kinds of row triggers that take an event (the others are entry, exit and anonymous).
  triggers: [event, table]
  # When a state completes (code model `completes`), as numbered in COMPLETES.
  completes:
    immediate: 0
    activities: 1
    regions: 2
    submachine: 3
    never: 4
---
{# ================================================================ pieces of C++ #}

{# The first lines of every file. #}
{% macro generated() %}
// Generated by FSM Editor from {{ machine.sourceFile }} (model hash {{ machine.modelHash }}).
// Do not edit: changes are lost when the code is regenerated.
{%- endmacro %}

{# A state or pseudostate of a table (code model `tables`), as an SML state. #}
{% macro sml_state(s) %}sml::state<{{ "pseudo" if s.kind == "pseudo" else "states" }}::{{ s.name | id }}>{% endmacro %}

{# The entry or exit steps of a state, on one line. #}
{% macro steps(list) -%}
{% for s in list -%}
{% if s.kind == "call" %} c.actions.{{ s.action | id }}();
{%- elif s.kind == "startActivity" %} c.actions.start{{ s.activity | pascal }}();
{%- elif s.kind == "stopActivity" %} c.actions.stop{{ s.activity | pascal }}();
{%- elif s.kind == "startTimer" %} c.startTimer({{ s.timerIndex }}, {{ s.ms }});
{%- elif s.kind == "cancelTimer" %} c.cancelTimer({{ s.timerIndex }});
{%- elif s.kind == "stopSubmachine" %} c.sub_{{ s.state }}.stopMachine();
{%- endif %}
{% endfor %}
{%- endmacro %}

{# An action of a table row: one statement of its lambda. #}
{% macro action(a) -%}
{% if a.kind == "stateEntry" %} c.enter({{ a.state.index }});{{ steps(a.state.entry) }}{{ " c.startSubmachine(" ~ a.state.index ~ ");" if a.state.submachine }} c.entered({{ a.state.index }});
{%- elif a.kind == "stateExit" %}{{ steps(a.state.exit) }} c.exited({{ a.state.index }});
{%- elif a.kind == "call" %} c.actions.{{ a.action | id }}();
{%- elif a.kind == "transition" %} c.trace("transition", {{ a.id | quote }}, {{ a.label | quote }});
{%- elif a.kind == "postcondition" %} c.postcondition({{ a.index }});
{%- elif a.kind == "terminate" %} c.terminate();
{%- elif a.kind == "exitMachine" %} c.exitMachine({{ machine.name }}ExitPoint::{{ a.point | id }});
{%- elif a.kind == "continue" %} c.next({{ a.event.index }});
{%- elif a.kind == "route" %} c.route({{ a.region }}, {{ a.route }}, {{ a.history }});
{%- elif a.kind == "submachineAt" %} c.startAt({{ a.state.index }}, {{ a.pointIndex }});
{%- elif a.kind == "entering" %} c.entering({{ a.region }});
{%- elif a.kind == "restore" %} c.restore({{ a.region }}, {{ a.state.index }});
{%- elif a.kind == "defer" %} c.defer();
{%- elif a.kind == "noBranch" %} c.noBranch({{ a.label | quote }});
{%- endif %}
{%- endmacro %}

{# Actions, one after the other. #}
{% macro row_actions(list) %}{% for a in list %}{{ action(a) }}{% endfor %}{% endmacro %}

{# A guard term of a table row: one operand of its guard's &&. #}
{% macro term(t) -%}
{% if t.kind == "condition" %}({{ t.condition | guard }})
{%- elif t.kind == "precondition" %}c.pre({{ t.condition | guard }}, {{ t.label | quote }})
{%- elif t.kind == "requires" %}c.allCompleted({ {{ t.states | map(attribute="index") | join(", ") }} })
{%- elif t.kind == "offer" %}c.sub_{{ t.state.name }}.offer({{ t.submachine }}Event::{{ t.event | id }})
{%- elif t.kind == "routed" %}c.routed({{ t.region }}, {{ t.route }})
{%- elif t.kind == "restores" %}c.restores({{ t.region }}, {{ t.route }}, {{ t.state.index }})
{%- elif t.kind == "defaults" %}c.defaults({{ t.region }})
{%- endif %}
{%- endmacro %}

{# The trigger of a table row, none for an anonymous one. #}
{% macro trigger(t) -%}
{% if t.kind == "event" %} + sml::event<events::{{ t.name | id }}>
{%- elif t.kind == "table" %} + sml::event<internal::{{ t.name | id }}>
{%- elif t.kind == "entry" %} + sml::on_entry<sml::_>
{%- elif t.kind == "exit" %} + sml::on_exit<sml::_>
{%- endif %}
{%- endmacro %}

{# The lambda of a table row: its actions (none when nothing is to be done). With deferred events, a row taking an
   event marks it fired, so that the event isn't deferred too. #}
{% macro row_lambda(r) -%}
{% set takes_event = features.deferral and r.trigger and r.trigger.kind in options.triggers %}
{% if r.actions or takes_event %} / [](Context& c) {
{{- " c.fired = true;" if takes_event and not (r.actions and r.actions[0].kind == "defer") }}{{ row_actions(r.actions) }} }
{%- endif %}
{%- endmacro %}

{# A table row: source, trigger, guard, actions, target. #}
{% macro row(r) -%}
{{ "(*" ~ sml_state(r.source) ~ ")" if r.initial else sml_state(r.source) }}
{{- trigger(r.trigger) if r.trigger }}
{%- if r.guard %} [([](Context& c) { return {% for t in r.guard %}{{ " && " if not loop.first }}{{ term(t) }}{% endfor %}; })]{% endif %}
{{- row_lambda(r) }}
{{- " = " ~ sml_state(r.target) if r.target }}
{%- endmacro %}

{# The body of a table's struct. #}
{% macro table(t) %}
    auto operator()() const {
        return sml::make_transition_table(
{% for r in t.rows %}
            {{ row(r) }}{{ "," if not loop.last }}{{ "  // " ~ r.comment if r.comment }}
{% endfor %}
        );
    }
{%- endmacro %}

{# ================================================================ checks #}

{% for e in events %}
{% if e.name in options.classMethods or e.name == machine.name %}
{% do error("Event '", e.name, "': its method ", e.name, "() clashes with a method of the generated class ", machine.name, "; rename the event") %}
{% endif %}
{% endfor %}
{% for a in actions %}
{% if a in conditions %}
{% do error("'", a, "' is called both as a behavior and as a condition: in C++ it would be two methods ", a, "() returning void and bool; rename one of them") %}
{% endif %}
{% if a in options.actionsMethods %}
{% do error("Behavior '", a, "': its method ", a, "() clashes with a method of ", machine.name, "Actions; rename it") %}
{% endif %}
{% endfor %}
{% for n in tables.notes %}
{% if n.kind == "leave" %}
{% do warn("Transition '", n.element, "': Boost.SML has no transitions out of a composite state's inside; ", n.state, " takes the event and ", n.detail, " is left through an internal event", id=n.id) %}
{% elif n.kind == "enter" %}
{% do warn("Transition '", n.element, "': Boost.SML has no transitions into a composite state's inside; it enters ", n.state, ", whose initial pseudostate leads on to ", n.detail, id=n.id) %}
{% elif n.kind == "exitPoint" %}
{% do warn("Exit point '", n.element, "': Boost.SML has no exit points; the state taking the event leaves the composite state through an internal event", id=n.id) %}
{% elif n.kind == "entryPoint" %}
{% do warn("Entry point '", n.element, "': Boost.SML has no entry points; transitions to it enter the state, whose initial pseudostates follow the entry point", id=n.id) %}
{% elif n.kind == "fork" %}
{% do warn("Fork '", n.element, "': Boost.SML has no forks; transitions to it enter the composite state, whose initial pseudostates lead to the fork's targets", id=n.id) %}
{% elif n.kind == "join" %}
{% do warn("Join '", n.element, "': Boost.SML has no joins; the completion of each source checks that the others have completed, then the composite state is left through an internal event", id=n.id) %}
{% elif n.kind == "history" %}
{% do warn("History '", n.element, "': Boost.SML's history (sml::H) is shallow and applies to every entry of the state; the generated code records each region's last active state, and the region's initial pseudostate restores it when entered through the ", n.detail, " history", id=n.id) %}
{% elif n.kind == "local" %}
{% do warn("Transition '", n.element, "': Boost.SML has no local transitions; it is written as a transition of each state of ", n.state, "'s region, which leaves the active substate but not ", n.state, id=n.id) %}
{% elif n.kind == "orthogonal" %}
{% do warn("In ", n.state, ", several regions react to '", n.detail, "': Boost.SML fires their transitions one region after the other, so the guards of a later region are evaluated after the transitions of the earlier ones fired", id=n.id) %}
{% endif %}
{% endfor %}
{% for p in tables.problems %}
{% if p.kind == "topRegions" %}
{% do error("Transition '", p.element, "': Boost.SML cannot run a transition between the machine's top-level regions", id=p.id) %}
{% elif p.kind == "localRegions" %}
{% do error("Transition '", p.element, "': Boost.SML has no local transitions, and ", p.state, " has several regions, which a transition of one region cannot leave together", id=p.id) %}
{% else %}
{% do error("Transition '", p.element, "': the Boost.SML tables cannot express it (", p.detail, ")", id=p.id) %}
{% endif %}
{% endfor %}

{# ================================================================ OrderEvents.h #}
{% filter file(machine.name ~ "Events.h") %}
{{ generated() }}
#pragma once

/// Events of {{ machine.displayName }}{{ ", including those of its submachines" if features.submachines }}.
enum class {{ machine.name }}Event {
{% for e in events %}
    {{ e.name | id }},
{% endfor %}
};
{% if features.activities %}

/// Do activities of {{ machine.displayName }}: report their end with activityDone().
enum class {{ machine.name }}Activity {
{% for a in activities %}
    {{ a | id }},
{% endfor %}
};
{% endif %}

/// What {{ machine.displayName }} reacts to. The class {{ machine.name }} implements it: call these methods to send it events.
class {{ machine.name }}Events {
public:
    virtual ~{{ machine.name }}Events() = default;
{% for e in events %}
    virtual void {{ e.name | id }}() = 0;
{% endfor %}
{% if features.activities %}
    /// A do activity ended by itself. Its state completes once all of its do activities have ended.
    virtual void activityDone({{ machine.name }}Activity activity) = 0;
{% endif %}
};
{% endfilter %}

{# ================================================================ OrderActions.h #}
{% filter file(machine.name ~ "Actions.h") %}
{{ generated() }}
#pragma once
{% if submachines %}

{% for sub in submachines %}
#include "{{ sub.name }}Actions.h"
{% endfor %}
{% endif %}
{% if features.constraints %}

/// Constraints reported to onConstraintViolation().
enum class {{ machine.name }}Constraint { invariant, precondition, postcondition };
{% endif %}

/// What {{ machine.displayName }} needs: implement it to give the machine its behavior, and pass it to {{ machine.name }}'s constructor.
{% if machine.documentation %}
///
/// {{ machine.documentation }}
{% endif %}
class {{ machine.name }}Actions {
public:
    virtual ~{{ machine.name }}Actions() = default;
{% if actions %}

    // Behaviors: entry, exit and transition effects.
{% for a in actions %}
    virtual void {{ a | id }}() = 0;
{% endfor %}
{% endif %}
{% if conditions %}

    // Conditions: guards{% if machine.protocol %}, invariants, pre- and postconditions{% elif features.invariants %} and invariants{% endif %}.
{% for c in conditions %}
    virtual bool {{ c | id }}() = 0;
{% endfor %}
{% endif %}
{% if activities %}

    // Do activities.
{% for a in activities %}
    /// Starts the do activity {{ a }}(). Call activityDone({{ machine.name }}Activity::{{ a | id }}) if it ends by itself.
    virtual void start{{ a | pascal }}() = 0;
    /// Aborts the do activity {{ a }}(): its state is being left.
    virtual void stop{{ a | pascal }}() = 0;
{% endfor %}
{% endif %}
{% if features.constraints %}

    /// A state invariant, precondition or postcondition does not hold. `element` names the state or transition.
    virtual void onConstraintViolation({{ machine.name }}Constraint kind, const char* element) = 0;
{% endif %}
{% if features.terminate %}

    /// The machine reached a terminate pseudostate and stopped.
    virtual void onTerminate() = 0;
{% endif %}
{% if features.submachines %}

    // Behavior of the submachine states.
{% for s in states if s.submachine %}
    virtual {{ s.submachine.machine }}Actions& submachine{{ s.name | pascal }}() = 0;
{% endfor %}
{% endif %}
};
{% endfilter %}

{# ================================================================ FsmTimers.h (the same for every machine) #}
{% if features.anyTimers %}
{% filter file("FsmTimers.h") %}
// Generated by FSM Editor.
// Do not edit: changes are lost when the code is regenerated.
#pragma once

#include <chrono>
#include <cstdint>
#include <functional>

/// Starts and cancels the timers of the time events (after(...)) of the state machines FSM Editor generates.
/// Implement it once and pass it to every machine that has time events, itself or in its submachines.
class FsmTimers {
public:
    using Id = std::uint64_t;

    virtual ~FsmTimers() = default;

    /// Calls fire() once, after delay, unless the timer is cancelled first. Call it on the thread that sends the
    /// machines their events, and never from within startTimer() or cancelTimer().
    virtual Id startTimer(std::chrono::milliseconds delay, std::function<void()> fire) = 0;
    /// Cancels a timer that startTimer() returned. A timer that has fired or was cancelled is ignored.
    virtual void cancelTimer(Id timer) = 0;
};
{% endfilter %}
{% endif %}

