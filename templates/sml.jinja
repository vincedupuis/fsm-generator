void {{ machine.name }}::resumeMachine() {
    runtime_->begin();
    for (int r = 0; r < {{ machine.name }}_sml::REGION_COUNT; ++r) {
        if ({{ machine.name }}_sml::OWNER_OF[r] < 0) runtime_->route(r, {{ machine.name }}_sml::DEEP, 2);
    }
    runtime_->enterMachine();
}

void {{ machine.name }}::stopMachine() {
    Runtime& c = *runtime_;
    if (!c.sm || c.terminated || c.running) return;
    {
        Runtime::Running guard(c.running);
        c.step({{ machine.name }}_sml::STOP, true);
    }
    c.queue.clear();
    c.work.clear();
}
{% for e in events %}

void {{ machine.name }}::{{ e.name | id }}() {
    if (runtime_->terminated) return;
    runtime_->queue.push_back({{ e.signalIndex }});
    runtime_->run();
}
