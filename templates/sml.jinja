void {{ machine.name }}::startMachineAt({{ machine.name }}EntryPoint point) {
    Runtime& c = *runtime_;
    c.begin();
    switch (point) {
{% for p in tables.entryPoints %}
    case {{ machine.name }}EntryPoint::{{ p.name | id }}:
       {{ row_actions(p.routes) }}
