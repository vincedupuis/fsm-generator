---
# TypeScript: a class per state machine, without dependencies.
# For a machine named Order it writes:
#   OrderActions.ts      events, states and the OrderActions interface to implement
#   Order.ts             the Order class (run-to-completion state machine)
# Implement OrderActions in your own class, in a file of your own.
lang: ts
guard:
  prefix: "this.actions."
---
{#- ================================================================ macros #}

{#- The steps of a transition, an entry or an exit (code model `Step`), one statement per line. #}
{% macro steps(list) %}
{% for s in list %}
{% if s.kind == "call" %}
this.actions.{{ s.action | id }}();
{% elif s.kind == "startActivity" %}
this.actions.start{{ s.activity | pascal }}();
{% elif s.kind == "stopActivity" %}
this.actions.stop{{ s.activity | pascal }}();
{% elif s.kind == "startTimer" %}
this.startTimer({{ s.timerIndex }}, {{ s.ms }}); // {{ s.timer }}
{% elif s.kind == "cancelTimer" %}
this.cancelTimer({{ s.timerIndex }}); // {{ s.timer }}
{% elif s.kind == "exit" %}
this.exit({{ s.stateIndex }}); // {{ s.state }}
{% elif s.kind == "exitRegion" %}
this.exitRegion({{ s.regionIndex }}); // {{ s.region }}
{% elif s.kind == "enter" %}
this.enter({{ s.stateIndex }}); // {{ s.state }}
{% elif s.kind == "enterRegion" %}
this.enterRegion({{ s.regionIndex }}); // {{ s.region }}
{% elif s.kind == "restoreHistory" %}
if (!this.restore({{ s.regionIndex }}, {{ s.deep | lower }})) { // {{ "deep " if s.deep }}history of {{ s.region }}
{% if s.defaultSteps %}
  {{ steps(s.defaultSteps) | indent(2) }}
{% endif %}
}
{% elif s.kind == "choice" %}
// {{ s.label }}
{% for b in s.branches %}
{% if loop.first %}
if ({{ b.guard | guard }}) {
{% elif b.guard %}
} else if ({{ b.guard | guard }}) {
{% else %}
} else {
{% endif %}
{% if b.steps %}
  {{ steps(b.steps) | indent(2) }}
{% endif %}
{% endfor %}
{% if s.hasElse %}
}
{% else %}
} else {
  this.noBranch({{ s.label | quote }});
}
{% endif %}
{% elif s.kind == "startSubmachine" %}
{% if s.point %}
this.submachines[{{ s.stateIndex }}].startAt({{ s.point | quote }}); // {{ s.state }}
{% else %}
this.submachines[{{ s.stateIndex }}].start(); // {{ s.state }}
{% endif %}
{% elif s.kind == "stopSubmachine" %}
this.submachines[{{ s.stateIndex }}].stop(); // {{ s.state }}
{% elif s.kind == "exitMachine" %}
this.exitMachine({{ s.point | quote }});
{% elif s.kind == "terminate" %}
this.terminate();
{% elif s.kind == "check" %}
if (!({{ s.condition | guard }})) this.actions.onConstraintViolation('{{ s.constraint }}', {{ s.element | quote }});
{% endif %}
{% endfor %}
{% endmacro %}

{#- A completion or exit point candidate: fires its transition when enabled. #}
{% macro take(c) %}
{% if c.guard or c.requires %}
if ({% if c.requires %}this.allCompleted([{{ c.requires | map(attribute="index") | join(", ") }}]){% endif %}{{ " && " if c.guard and c.requires }}{% if c.guard %}({{ c.guard | guard }}){% endif %}) {
  this.fire({{ c.transitionIndex }}); // {{ c.transition }}
  return true;
}
{% else %}
this.fire({{ c.transitionIndex }}); // {{ c.transition }}
return true;
{% endif %}
{% endmacro %}

{#- An event's candidate: chosen when enabled, fired once every region has chosen. #}
{% macro choose(c) %}
{% if c.precondition %}
if ({{ c.guard | guard }}) {
  if ({{ c.precondition | guard }}) {
    chosen.push({{ c.transitionIndex }}); // {{ c.transition }}
    return true;
  }
  if (!this.preconditionFailed) this.preconditionFailed = {{ c.label | quote }};
}
{% elif c.guard %}
if ({{ c.guard | guard }}) {
  chosen.push({{ c.transitionIndex }}); // {{ c.transition }}
  return true;
}
{% else %}
chosen.push({{ c.transitionIndex }}); // {{ c.transition }}
return true;
{% endif %}
{% endmacro %}

{#- ================================================================ OrderActions.ts #}
{% filter file(machine.name ~ "Actions.ts") %}
// Generated by FSM Editor from {{ machine.sourceFile }}.
// Do not edit: changes are lost when the code is regenerated.
{% for sub in submachines %}
import type { {{ sub.name }}Actions } from './{{ sub.name }}Actions';
{% endfor %}

/** Events accepted by {{ machine.displayName }}{{ ", including those of its submachines" if features.submachines }}. */
export type {{ machine.name }}Event = {{ events | map(attribute="name") | map("quote") | join(" | ") or "never" }};

/** States of {{ machine.displayName }}. */
export type {{ machine.name }}State = {{ states | map(attribute="name") | map("quote") | join(" | ") or "never" }};

/** Do activities; report their end with activityDone(). */
export type {{ machine.name }}Activity = {{ activities | map("quote") | join(" | ") or "never" }};

/** Entry points, for startAt(). */
export type {{ machine.name }}EntryPoint = {{ entryPoints | map(attribute="name") | map("quote") | join(" | ") or "never" }};

/** Exit points, reported to onExitPoint. */
export type {{ machine.name }}ExitPoint = {{ exitPoints | map(attribute="name") | map("quote") | join(" | ") or "never" }};

/**
 * What {{ machine.displayName }} calls: implement it to give the machine its behavior.
{% if machine.documentation %}
 *
 * {{ machine.documentation }}
{% endif %}
 */
export interface {{ machine.name }}Actions {
{% for a in actions %}
  {{ a | id }}(): void;
{% endfor %}
{% for c in conditions %}
  {{ c | id }}(): boolean;
{% endfor %}
{% for a in activities %}
  /** Starts the do activity {{ a }}(). Call activityDone({{ a | quote }}) if it ends by itself. */
  start{{ a | pascal }}(): void;
  /** Aborts the do activity {{ a }}(): its state is being left. */
  stop{{ a | pascal }}(): void;
{% endfor %}
{% if features.constraints %}
  /** A state invariant, precondition or postcondition does not hold. */
  onConstraintViolation(kind: 'invariant' | 'precondition' | 'postcondition', element: string): void;
{% endif %}
{% if features.terminate %}
  /** The machine reached a terminate pseudostate and stopped. */
  onTerminate(): void;
{% endif %}
{% if features.submachines %}
  /** Behavior of the submachine states. */
  readonly submachines: {
{% for s in states if s.submachine %}
    {{ s.name }}: {{ s.submachine.machine }}Actions;
{% endfor %}
  };
{% endif %}
}

/** Schedules time events. The default uses setTimeout; tests can pass a fake one. */
export interface Clock {
  setTimeout(callback: () => void, ms: number): unknown;
  clearTimeout(handle: unknown): void;
}

export interface {{ machine.name }}Options {
  clock?: Clock;
  /** The machine reached a final state in every top-level region. */
  onFinished?(): void;
  /** The machine left through one of its exit points. */
  onExitPoint?(point: {{ machine.name }}ExitPoint): void;
}
{% endfilter %}
{#- ================================================================ Order.ts #}
{% filter file(machine.name ~ ".ts") %}
// Generated by FSM Editor from {{ machine.sourceFile }}.
// Do not edit: changes are lost when the code is regenerated.
import type {
  Clock,
  {{ machine.name }}Actions,
  {{ machine.name }}Activity,
  {{ machine.name }}EntryPoint,
  {{ machine.name }}Event,
  {{ machine.name }}ExitPoint,
  {{ machine.name }}Options,
  {{ machine.name }}State,
} from './{{ machine.name }}Actions';
{% for sub in submachines %}
import { {{ sub.name }} } from './{{ sub.name }}';
{% endfor %}

export type {
  Clock,
  {{ machine.name }}Actions,
  {{ machine.name }}Activity,
  {{ machine.name }}EntryPoint,
  {{ machine.name }}Event,
  {{ machine.name }}ExitPoint,
  {{ machine.name }}Options,
  {{ machine.name }}State,
};

const NONE = 0;
const DEFERRED = 1;
const FIRED = 2;
const COMPLETION = 0;
const EXIT_POINT = 1;

const STATE_NAMES: readonly {{ machine.name }}State[] = [{{ states | map(attribute="name") | map("quote") | join(", ") }}];
/** Region containing each state. */
const REGION_OF: readonly number[] = [{{ states | map(attribute="regionIndex") | join(", ") }}];
/** Regions of each state. */
const REGIONS_OF: readonly (readonly number[])[] = [{% for s in states %}{{ ", " if not loop.first }}[{{ s.regions | map(attribute="index") | join(", ") }}]{% endfor %}];
/** State owning each region (-1 for top-level regions). */
const OWNER_OF: readonly number[] = [{{ regions | map(attribute="ownerIndex") | join(", ") }}];
const TOP_REGIONS: readonly number[] = [{{ topRegions | map(attribute="index") | join(", ") }}];
const IS_FINAL: readonly boolean[] = [{{ states | map(attribute="isFinal") | map("lower") | join(", ") }}];
/** When each state completes. */
const COMPLETES: readonly string[] = [{{ states | map(attribute="completes") | map("quote") | join(", ") }}];
{% if features.activities %}
const STATE_ACTIVITIES: readonly (readonly string[])[] = [{% for s in states %}{{ ", " if not loop.first }}[{{ s.activities | map("quote") | join(", ") }}]{% endfor %}];
{% endif %}
{% if features.deferral %}
/** Events deferred by each state. */
const DEFERS: readonly (readonly number[])[] = [{% for s in states %}{{ ", " if not loop.first }}[{{ s.deferred | map(attribute="index") | join(", ") }}]{% endfor %}];
{% endif %}
const EVENT_COUNT = {{ events | length }};
const EVENT_SIGNAL: Readonly<Record<string, number>> = { {% for e in events %}{{ ", " if not loop.first }}{{ e.name | quote }}: {{ e.signalIndex }}{% endfor %} };
const SIGNAL_NAMES: readonly string[] = [{{ signals | map(attribute="name") | map("quote") | join(", ") }}];
/** Main source state of each transition. */
const SOURCE_OF: readonly number[] = [{{ transitions | map(attribute="sourceIndex") | join(", ") }}];

/** A generated state machine used as a submachine. */
interface Submachine {
  start(): void;
  startAt(point: string): void;
  resume(): void;
  stop(): void;
  offer(event: string): number;
}

/**
 * {{ machine.displayName }}{{ " (protocol state machine)" if machine.protocol }}.
 *
 * Events are processed one at a time, each to completion. Call start() once,
 * then dispatch() events.
 */
export class {{ machine.name }} {
  private readonly active: number[] = new Array({{ regions | length }}).fill(-1);
  private readonly history: number[] = new Array({{ regions | length }}).fill(-1);
  private readonly completed: boolean[] = new Array({{ states | length }}).fill(false);
  private readonly queue: number[] = [];
  private readonly work: [number, number, string][] = [];
  private running = false;
  private finished = false;
  private terminated = false;
{% if features.activities %}
  private readonly pending: number[] = new Array({{ states | length }}).fill(0);
{% endif %}
{% if features.deferral %}
  private deferred: number[] = [];
{% endif %}
{% if features.preconditions %}
  private preconditionFailed = '';
{% endif %}
{% if features.timers %}
  private readonly clock: Clock;
  private readonly timerHandles: unknown[] = new Array({{ timers | length }}).fill(undefined);
{% endif %}
  private readonly submachines: Record<number, Submachine> = {};

  constructor(
    private readonly actions: {{ machine.name }}Actions,
    private readonly options: {{ machine.name }}Options = {},
  ) {
{% if features.timers %}
    this.clock = options.clock ?? {
      setTimeout: (callback, ms) => setTimeout(callback, ms),
      clearTimeout: (handle) => clearTimeout(handle as ReturnType<typeof setTimeout>),
    };
{% endif %}
{% for s in states if s.submachine %}
    this.submachines[{{ s.index }}] = new {{ s.submachine.machine }}(actions.submachines.{{ s.name }}, {
      clock: options.clock,
      onFinished: () => this.post(COMPLETION, {{ s.index }}, ''),
      onExitPoint: (point: string) => this.post(EXIT_POINT, {{ s.index }}, point),
    });
{% endfor %}
  }

  /** Enters the machine through its initial pseudostates. */
  start(): void {
    this.reset();
    this.running = true;
    try {
      {{ steps(start) | indent(6) }}
    } finally {
      this.running = false;
    }
    this.run();
  }

  /** Enters the machine through one of its entry points. */
  startAt(point: {{ machine.name }}EntryPoint): void {
    this.reset();
    this.running = true;
    try {
      switch (point) {
{% for p in entryPoints %}
        case {{ p.name | quote }}:
          {{ steps(p.steps) | indent(10) }}
          break;
{% endfor %}
      }
    } finally {
      this.running = false;
    }
    this.run();
  }

  /** Re-enters the states that were active when the machine was last stopped. */
  resume(): void {
    this.reset();
    this.running = true;
    try {
      for (const region of TOP_REGIONS) if (!this.restore(region, true)) this.enterRegion(region);
    } finally {
      this.running = false;
    }
    this.run();
  }

  /** Leaves every active state, running their exit behaviors. */
  stop(): void {
    for (const region of TOP_REGIONS) this.exitRegion(region);
    this.queue.length = 0;
    this.work.length = 0;
  }

  /** Processes `event` after the events already queued. */
  dispatch(event: {{ machine.name }}Event): void {
    if (this.terminated) return;
    this.queue.push(EVENT_SIGNAL[event]);
    this.run();
  }
{% if features.activities %}

  /** A do activity ended by itself; its state completes once all its activities have ended. */
  activityDone(activity: {{ machine.name }}Activity): void {
    STATE_ACTIVITIES.forEach((list, s) => {
      if (list.includes(activity) && this.isActive(s) && this.pending[s] > 0 && --this.pending[s] === 0) this.completion(s);
    });
    this.run();
  }
{% endif %}

  isIn(state: {{ machine.name }}State): boolean {
    return this.isActive(STATE_NAMES.indexOf(state));
  }

  get activeStates(): {{ machine.name }}State[] {
    return STATE_NAMES.filter((_, s) => this.isActive(s));
  }

  /** Every top-level region reached a final state. */
  get isFinished(): boolean {
    return this.finished;
  }

  /** A terminate pseudostate was reached. */
  get isTerminated(): boolean {
    return this.terminated;
  }

  /** @internal Offers an event to this machine running as a submachine; returns whether it was used. */
  offer(event: string): number {
    const signal = EVENT_SIGNAL[event];
    if (signal === undefined || this.terminated || this.running) return NONE;
    let result: number;
    this.running = true;
    try {
      result = this.process(signal);
    } finally {
      this.running = false;
    }
    this.run();
    return result === NONE ? NONE : FIRED;
  }

  // ---------------------------------------------------------------- run to completion

  private reset(): void {
    this.active.fill(-1);
    this.completed.fill(false);
    this.queue.length = 0;
    this.work.length = 0;
    this.finished = false;
    this.terminated = false;
{% if features.deferral %}
    this.deferred = [];
{% endif %}
  }

  private run(): void {
    if (this.running) return;
    this.running = true;
    try {
      while (!this.terminated) {
        const item = this.work.shift();
        if (item) {
          const [kind, s, point] = item;
          if (this.isActive(s) && (kind === COMPLETION ? this.complete(s) : this.exitPoint(s, point))) {
            this.changed();
            this.checkInvariants();
          }
          continue;
        }
        const signal = this.queue.shift();
        if (signal === undefined) break;
        this.process(signal);
      }
    } finally {
      this.running = false;
    }
  }

  private post(kind: number, s: number, point: string): void {
    this.work.push([kind, s, point]);
    this.run();
  }

  /** One run-to-completion step: selects the enabled transitions, then fires them. */
  private process(signal: number): number {
{% if features.preconditions %}
    this.preconditionFailed = '';
{% endif %}
    const chosen: number[] = [];
    let result = NONE;
    for (const region of TOP_REGIONS) result = Math.max(result, this.selectRegion(region, signal, chosen));
    for (const t of chosen) if (!this.terminated && this.isActive(SOURCE_OF[t])) this.fire(t);
    if (result === FIRED) this.changed();
{% if features.deferral %}
    else if (result === DEFERRED) this.deferred.push(signal);
{% endif %}
{% if features.preconditions %}
    else if (this.preconditionFailed) this.actions.onConstraintViolation('precondition', this.preconditionFailed);
{% endif %}
    this.checkInvariants();
    return result;
  }

  /** The configuration changed: deferred events get another chance. */
  private changed(): void {
{% if features.deferral %}
    if (this.deferred.length) {
      this.queue.unshift(...this.deferred);
      this.deferred = [];
    }
{% endif %}
  }

  private selectRegion(region: number, signal: number, chosen: number[]): number {
    const s = this.active[region];
    return s < 0 ? NONE : this.selectState(s, signal, chosen);
  }

  /** Nested states first: a state's own transitions only apply when no substate used the event. */
  private selectState(s: number, signal: number, chosen: number[]): number {
    let result = NONE;
    for (const region of REGIONS_OF[s]) result = Math.max(result, this.selectRegion(region, signal, chosen));
    const sub = this.submachines[s];
    if (sub && signal < EVENT_COUNT) result = Math.max(result, sub.offer(SIGNAL_NAMES[signal]));
    if (result !== NONE) return result;
    if (this.select(s, signal, chosen)) return FIRED;
{% if features.deferral %}
    if (DEFERS[s].includes(signal)) return DEFERRED;
{% endif %}
    return NONE;
  }

  /** The first enabled transition of `s` triggered by `signal`. */
  private select(s: number, signal: number, chosen: number[]): boolean {
    switch (s) {
{% for s in states if s.handlers %}
      case {{ s.index }}: // {{ s.name }}
        switch (signal) {
{% for h in s.handlers %}
          case {{ h.signalIndex }}: // {{ h.signal }}
{% for c in h.candidates %}
            {{ choose(c) | indent(12) }}
{% endfor %}
{% if not h.exhaustive %}
            break;
{% endif %}
{% endfor %}
        }
        break;
{% endfor %}
    }
    return false;
  }

  /** Completion event of `s`: its first enabled completion transition fires. */
  private complete(s: number): boolean {
    switch (s) {
{% for s in states if s.completion %}
      case {{ s.index }}: // {{ s.name }}
{% for c in s.completion %}
        {{ take(c) | indent(8) }}
{% endfor %}
        break;
{% endfor %}
    }
    return false;
  }

  /** The submachine of state `s` left through its exit point `point`. */
  private exitPoint(s: number, point: string): boolean {
    switch (s) {
{% for s in states if s.exits %}
      case {{ s.index }}: // {{ s.name }}
        switch (point) {
{% for x in s.exits %}
          case {{ x.point | quote }}:
{% for c in x.candidates %}
            {{ take(c) | indent(12) }}
{% endfor %}
            break;
{% endfor %}
        }
        break;
{% endfor %}
    }
    return false;
  }

  private fire(t: number): void {
    switch (t) {
{% for t in transitions %}
      case {{ t.index }}: { // {{ t.label }}
{% if t.steps %}
        {{ steps(t.steps) | indent(8) }}
{% endif %}
        break;
      }
{% endfor %}
    }
  }

  // ---------------------------------------------------------------- entering and leaving states

  /** Enters `s` itself (not its regions) and runs its entry behavior. */
  private enter(s: number): void {
    this.active[REGION_OF[s]] = s;
    this.completed[s] = false;
{% if features.activities %}
    if (COMPLETES[s] === 'activities') this.pending[s] = STATE_ACTIVITIES[s].length;
{% endif %}
    switch (s) {
{% for s in states if s.entry %}
      case {{ s.index }}: // {{ s.name }}
        {{ steps(s.entry) | indent(8) }}
        break;
{% endfor %}
    }
    if (IS_FINAL[s]) this.finalReached(REGION_OF[s]);
    else if (COMPLETES[s] === 'immediate') this.completion(s);
  }

  /** Leaves `s` and everything active inside it, innermost first. */
  private exit(s: number): void {
    const region = REGION_OF[s];
    if (this.active[region] !== s) return;
    for (const r of REGIONS_OF[s]) this.exitRegion(r);
    switch (s) {
{% for s in states if s.exit %}
      case {{ s.index }}: // {{ s.name }}
        {{ steps(s.exit) | indent(8) }}
        break;
{% endfor %}
    }
    this.active[region] = -1;
    this.history[region] = IS_FINAL[s] ? -1 : s;
    this.completed[s] = false;
  }

  private exitRegion(region: number): void {
    const s = this.active[region];
    if (s >= 0) this.exit(s);
  }

  /** Default entry of a region: the transition of its initial pseudostate. */
  private enterRegion(region: number): void {
    switch (region) {
{% for r in regions if r.defaultSteps %}
      case {{ r.index }}: // {{ r.name }}
        {{ steps(r.defaultSteps) | indent(8) }}
        break;
{% endfor %}
    }
  }

  /** Re-enters the state last active in `region`; false when there is none. */
  private restore(region: number, deep: boolean): boolean {
    const s = this.history[region];
    if (s < 0) return false;
    this.enter(s);
    for (const r of REGIONS_OF[s]) if (!deep || !this.restore(r, true)) this.enterRegion(r);
    const sub = this.submachines[s];
    if (sub) {
      if (deep) sub.resume();
      else sub.start();
    }
    return true;
  }

  private finalReached(region: number): void {
    const owner = OWNER_OF[region];
    const regions = owner < 0 ? TOP_REGIONS : REGIONS_OF[owner];
    if (!regions.every((r) => this.active[r] >= 0 && IS_FINAL[this.active[r]])) return;
    if (owner >= 0) this.completion(owner);
    else {
      this.finished = true;
      this.options.onFinished?.();
    }
  }

  private completion(s: number): void {
    this.completed[s] = true;
    this.work.push([COMPLETION, s, '']);
  }

  private allCompleted(states: number[]): boolean {
    return states.every((s) => this.isActive(s) && this.completed[s]);
  }

  private isActive(s: number): boolean {
    return s >= 0 && this.active[REGION_OF[s]] === s;
  }

  private exitMachine(point: {{ machine.name }}ExitPoint): void {
    for (const region of TOP_REGIONS) this.exitRegion(region);
    this.options.onExitPoint?.(point);
  }
{% if features.terminate %}

  private terminate(): void {
    this.terminated = true;
{% if features.timers %}
    for (let t = 0; t < this.timerHandles.length; t++) this.cancelTimer(t);
{% endif %}
    this.queue.length = 0;
    this.work.length = 0;
    this.actions.onTerminate();
  }
{% endif %}
{% if features.choices %}

  private noBranch(choice: string): never {
    throw new Error(`{{ machine.name }}: no branch of the ${choice} can be taken.`);
  }
{% endif %}

  private checkInvariants(): void {
{% for s in invariants %}
    if (this.isActive({{ s.index }}) && !({{ s.invariant | guard }})) this.actions.onConstraintViolation('invariant', {{ s.name | quote }});
{% endfor %}
  }
{% if features.timers %}

  private startTimer(timer: number, ms: number): void {
    this.cancelTimer(timer);
    this.timerHandles[timer] = this.clock.setTimeout(() => {
      this.timerHandles[timer] = undefined;
      this.queue.push(EVENT_COUNT + timer);
      this.run();
    }, ms);
  }

  private cancelTimer(timer: number): void {
    const handle = this.timerHandles[timer];
    if (handle !== undefined) {
      this.clock.clearTimeout(handle);
      this.timerHandles[timer] = undefined;
    }
  }
{% endif %}
}
{% endfilter %}
